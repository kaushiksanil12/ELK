####################################################################
#  ELK STACK — ENVIRONMENT CONFIGURATION
#  Copy this file to .env and customise before running setup.sh
####################################################################

# ──────────────────────────────────────────────
# VERSION
# ──────────────────────────────────────────────
STACK_VERSION=9.5.0

# ──────────────────────────────────────────────
# CLUSTER IDENTITY
# ──────────────────────────────────────────────
CLUSTER_NAME=elk-cluster
ELASTICSEARCH_NODE_NAME=es-node-01

# ──────────────────────────────────────────────
# SECURITY — PASSWORDS & API KEYS
# (change before production use)
# ──────────────────────────────────────────────
ELASTIC_PASSWORD=changeme_elastic
KIBANA_SYSTEM_PASSWORD=changeme_kibana_system
KIBANA_ENCRYPTION_KEY=CHANGE_ME_min_32_chars_random_string

# ──────────────────────────────────────────────
# NETWORK / PORTS
# ──────────────────────────────────────────────
ES_PORT=9200
ES_TRANSPORT_PORT=9300
KIBANA_PORT=5601
FLEET_SERVER_PORT=8220
APM_SERVER_PORT=8200

# ──────────────────────────────────────────────
# JVM HEAP SIZE  (Elasticsearch only)
# Rule of thumb: 50 % of available RAM, max 31g
# ──────────────────────────────────────────────
ES_JVM_HEAP=1g               # e.g. 4g for production

# ──────────────────────────────────────────────
# DOCKER RESOURCE LIMITS (per container)
# ──────────────────────────────────────────────
ES_MEM_LIMIT=2g              # Docker memory hard limit
ES_CPU_LIMIT=2.0             # Docker CPU quota (cores)
KIBANA_MEM_LIMIT=1g
KIBANA_CPU_LIMIT=1.0
FLEET_MEM_LIMIT=512m
FLEET_CPU_LIMIT=0.5

# ──────────────────────────────────────────────
# ELASTICSEARCH RESOURCE / INDEX LIMITS
# ──────────────────────────────────────────────
ES_MAX_SHARDS_PER_NODE=1000
ES_RECOVERY_MAX_BYTES_PER_SEC=40mb
ES_INDICES_FIELDDATA_CACHE_SIZE=20%       # % of heap
ES_CIRCUIT_BREAKER_REQUEST_LIMIT=60%
ES_CIRCUIT_BREAKER_TOTAL_LIMIT=70%
ES_CIRCUIT_BREAKER_FIELDDATA_LIMIT=40%

# Disk watermarks
ES_WATERMARK_LOW=85%          # stop routing shards when disk > 85%
ES_WATERMARK_HIGH=90%         # start relocating shards
ES_WATERMARK_FLOOD_STAGE=95%  # enforce read-only index

# Thread pool queue sizes
ES_THREADPOOL_WRITE_QUEUE=500
ES_THREADPOOL_SEARCH_QUEUE=1000


# ──────────────────────────────────────────────
# KIBANA SETTINGS
# ──────────────────────────────────────────────
KIBANA_REPORTING_ENCRYPT_KEY=CHANGE_ME_min_32_chars_random_string
KIBANA_MAX_PAYLOAD=1048576    # bytes – default 1 MB

# ──────────────────────────────────────────────
# FLEET SERVER
# Elastic Agent runs on REMOTE servers — not here.
# Set ELK_SERVER_PUBLIC_IP to the IP/hostname that
# remote agents will use to reach Fleet Server.
# ──────────────────────────────────────────────
FLEET_SERVER_POLICY=fleet-server-policy
FLEET_SERVER_HOST=0.0.0.0

# ── TLS Subject Alternative Names (SANs) ──────────────────────────────────────
# Both values are injected into the TLS certificates at first run.
# Remote agents use these to connect to Fleet Server WITHOUT --insecure.
#
# ELK_SERVER_PUBLIC_IP  — the public/private IP of this ELK server
# ELK_SERVER_DOMAIN     — a domain name pointing to this server (optional but recommended)
#                         e.g.  elk.mycompany.com  or  monitoring.internal
#
# If you have a domain → set both. Agents should use the domain in --fleet-url.
# If you only have an IP → set only ELK_SERVER_PUBLIC_IP. Agents use the IP.
#
# ⚠️  After changing these, delete the certs volume and rerun setup.sh --clean
#     so certs are regenerated with the new SANs.
# ──────────────────────────────────────────────────────────────────────────────
ELK_SERVER_PUBLIC_IP=YOUR_ELK_SERVER_IP
ELK_SERVER_DOMAIN=

# ──────────────────────────────────────────────
# TLS / CERTS (auto-generated by setup.sh)
# ──────────────────────────────────────────────
CA_CERT=config/certs/ca/ca.crt
ES_CERT=config/certs/elasticsearch/elasticsearch.crt
ES_KEY=config/certs/elasticsearch/elasticsearch.key

# ──────────────────────────────────────────────
# DATA / LOG PATHS  (Docker volumes)
# ──────────────────────────────────────────────
ES_DATA_VOLUME=esdata
KIBANA_DATA_VOLUME=kibanadata
FLEET_DATA_VOLUME=fleetdata
CERTS_VOLUME=certs

# ════════════════════════════════════════════════════════════════════════════
# LOG VOLUME CONTROL
# 70 GB / 5 days ≈ 14 GB/day — use these settings to manage disk usage.
# Changes here apply automatically on next ./setup.sh run.
# ════════════════════════════════════════════════════════════════════════════

# ── ILM (Index Lifecycle Management) — retention & rollover ──────────────────
# Controls how long data lives and when it moves between hot/warm/cold/delete.
#
#  hot   → actively written, fastest storage
#  warm  → read-only, shrunk & force-merged (saves ~30% extra space)
#  cold  → rarely accessed, read-only
#  delete→ purged permanently
#
# Tune ILM_DELETE_AFTER to control total disk usage.
# At 14 GB/day with best_compression, expect ~5-6 GB/day stored.
# ─────────────────────────────────────────────────────────────────────────────
ILM_POLICY_NAME=elk-logs-policy

ILM_ROLLOVER_MAX_AGE=1d         # Roll index daily
ILM_ROLLOVER_MAX_SHARD_SIZE=10gb # Or when a shard hits 10 GB

ILM_WARM_AFTER=2d               # Move to warm after 2 days (shrink + forcemerge)
ILM_COLD_AFTER=7d               # Move to cold after 7 days (read-only)
ILM_DELETE_AFTER=30d            # Delete after 30 days  ← main retention knob
                                 # Set to 7d for 7-day retention, 14d for 2 weeks etc.

# ── Index settings applied to all logs-* / metrics-* indices ─────────────────
ES_DEFAULT_SHARDS=1             # Single-node: always 1 (no benefit from more)
ES_DEFAULT_REPLICAS=0           # Single-node: replicas must be 0 (no peers to replicate to)
                                 # Set to 1 if you add a second Elasticsearch node.

# best_compression uses ZSTD — ~60-70% smaller than default LZ4.
# Already set in the index template via setup.sh, listed here for visibility.
# To change: update setup.sh INDEX_TEMPLATE codec field.

ES_REFRESH_INTERVAL=30s         # How often ES makes new docs searchable.
                                 # Default is 1s. 30s reduces I/O write amplification
                                 # by ~30x with minimal search latency impact for logs.

# ── Mapping limits — prevent "mapping explosion" ──────────────────────────────
# A noisy app can create thousands of dynamic fields, each eating heap memory.
ES_MAPPING_TOTAL_FIELDS_LIMIT=500   # Max fields per index (default: 1000)
ES_DYNAMIC_MAPPING=strict           # Options: true | false | strict
                                    #   true   → auto-create fields (default, risky)
                                    #   strict → reject docs with unknown fields (safe)
                                    #   false  → ignore unknown fields silently
