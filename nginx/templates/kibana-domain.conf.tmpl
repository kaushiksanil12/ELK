server {
    listen 80;
    server_name ${ELK_SERVER_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${ELK_SERVER_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ELK_SERVER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ELK_SERVER_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH";

    # Use Docker's internal DNS — resolves container names at request time (not startup)
    resolver 127.0.0.11 valid=30s ipv6=off;

    location / {
        set $kibana_upstream https://kibana:${KIBANA_PORT};
        proxy_pass $kibana_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }
}

server {
    listen 9200 ssl;
    server_name ${ELK_SERVER_DOMAIN};

    ssl_certificate /etc/letsencrypt/live/${ELK_SERVER_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ELK_SERVER_DOMAIN}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH";

    # Elasticsearch has a 100MB payload limit default, allow large requests
    client_max_body_size 100M;

    resolver 127.0.0.11 valid=30s ipv6=off;

    location / {
        set $es_upstream https://elasticsearch:9200;
        proxy_pass $es_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_ssl_verify off;
    }
}

